# ---- Origin Design Agent OS — environment template ----------------------------
# Copy to `.env` at this directory (read by both apps/api and infra/docker-compose.yml).
# Generate real secrets with:  cd apps/api && python -m app.cli generate-keys

APP_ENV=development                      # development | test | staging | production
LOG_FORMAT=console                       # console | json (json in staging/production)
LOG_LEVEL=INFO

# Data stores
DATABASE_URL=postgresql+psycopg://origin:origin@localhost:5432/origin
REDIS_URL=                               # redis://localhost:6379/0 (required for redis queue/event bus)

# Pluggable adapters (see docs/ARCHITECTURE.md §3)
STORAGE_BACKEND=local                    # local | s3      (s3 required in staging/production)
LOCAL_STORAGE_PATH=.data/storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=origin-assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
SECRET_BACKEND=fernet                    # fernet | env
QUEUE_BACKEND=inline                     # inline | redis  (redis required in staging/production)
EVENT_BUS_BACKEND=memory                 # memory | redis  (redis required in staging/production)
WORKFLOW_SCHEDULER=sequential            # sequential | dag
EMBEDDINGS_BACKEND=none                  # none | openai (needs pgvector)

# Security (never commit real values)
JWT_SECRET=dev-only-not-for-production
ENCRYPTION_KEY=                          # Fernet key; required when SECRET_BACKEND=fernet outside development
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Provider convenience for a single-provider V0 server deployment (admin-managed providers override)
OPENAI_API_KEY=
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
PROVIDER_RETRY_ATTEMPTS=3                # bounded backoff for retryable provider errors (never after a tool call)
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# Custom REST integrations (Admin → API Integrations → Custom APIs)
OUTBOUND_ALLOW_HTTP=false                # https only; may be true in development, refused in production
OUTBOUND_ALLOWED_HOSTS=                  # comma-separated allowlist, e.g. api.example.com,svc.partner.net (empty = any public host)
OUTBOUND_MAX_RESPONSE_BYTES=5242880
OUTBOUND_DEFAULT_TIMEOUT_SECONDS=30

# First admin (development only; in staging/production use `python -m app.cli bootstrap-admin`)
BOOTSTRAP_ADMIN_EMAIL=admin@origin.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ORGANIZATION_NAME=Origin

# Web app (public values only — never put secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
